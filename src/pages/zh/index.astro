---
import BaseLayout from '../../layouts/BaseLayout.astro';
import HomePage from '../../components/HomePageRedesign.astro';
import { getCollection } from 'astro:content';
import { sortBlogPosts } from '../../lib/blog-sort';
import { sortTools } from '../../lib/tools-sort';

const lang = 'zh';
const posts = sortBlogPosts(
	await getCollection('blog', (entry) => entry.data.lang === lang && !entry.data.draft)
);

const pinnedPost = posts.find((post) => (post.data.priority ?? 0) === 9999);
const latestPosts = pinnedPost
	? [pinnedPost, ...posts.filter((p) => p !== pinnedPost).slice(0, 2)]
	: posts.slice(0, 3);

const featuredPost = latestPosts[0];
const secondaryPosts = latestPosts.slice(1, 3);

const docs = await getCollection('docs', (entry) => entry.data.lang === lang);
const projects = (await getCollection('projects', (entry) => entry.data.lang === lang && entry.data.featured !== false)).sort(
	(a, b) => {
		if (a.data.order !== b.data.order) return a.data.order - b.data.order;
		return a.data.title.localeCompare(b.data.title);
	}
);
const tools = sortTools(
	await getCollection('tools', (entry) => entry.data.lang === lang && entry.data.featured !== false)
);

const docsBySection = new Map<string, number>();
for (const doc of docs) {
	const section = (doc.data.section || '其他').trim();
	docsBySection.set(section, (docsBySection.get(section) ?? 0) + 1);
}

const docsOverviewCards = [
	{
		section: '入门',
		description: '先从这里进入，快速理解本站结构、阅读顺序和基础知识入口。',
		count: docsBySection.get('入门') ?? 0,
	},
	{
		section: '服务端',
		description: '覆盖 Java、Rust、Go、Python 等方向，从概览到实战逐步展开。',
		count: docsBySection.get('服务端') ?? 0,
	},
	{
		section: '数据库',
		description: '围绕 MySQL、PostgreSQL、Redis 整理核心概念、取舍和使用经验。',
		count: docsBySection.get('数据库') ?? 0,
	},
];

const featuredProjects = projects.slice(0, 2);
const featuredTools = tools.slice(0, 6);

const labels = {
	heroKicker: '个人知识站点',
	heroTitle: '欢迎来到布吉岛！',
	heroLead: '把无聊做有趣，把复杂讲清楚，把问题解决！',
	heroNote: '重点入口已经收束到最新内容、文档中心和精选项目。',
	primaryAction: { href: '/zh/docs/', label: '进入文档中心' },
	secondaryAction: { href: '/zh/blog/', label: '查看最新文章', style: 'ghost' as const },
	stats: [
		{ label: '文档', value: String(docs.length), hint: '按主题整理，适合系统阅读。' },
		{ label: '项目', value: String(projects.length), hint: '保留可持续维护的实践输出。' },
		{ label: '工具', value: String(tools.length), hint: '常用在线工具直接可用。' },
	],
	spotlightLabel: '阅读建议',
	spotlightTitle: '如果你第一次来到这里，先从文档区进入。',
	spotlightBody: '首页现在把文档放到更靠前的位置，用更强的视觉层次表达核心内容，减少“所有卡片都差不多”的问题。',
	spotlightLink: '/zh/docs/',
	latestSection: 'Latest',
	latestMore: '查看全部文章',
	latestFeatured: '重点推荐',
	latestContinue: '继续阅读',
	latestRead: '阅读文章',
	latestFallback: '还没有文章。',
	latestArticleType: '博客文章',
	latestTagFallback: '文章',
	docsSection: 'Docs',
	docsMore: '查看全部文档',
	docsSummaryTitle: '文档区现在是首页的第一优先级入口。',
	docsSummaryBody: '用更清晰的卡片分层展示三类核心主题，先解决“从哪里开始看”的问题，再解决“具体看什么”的问题。',
	docsSummaryLink: '浏览文档体系',
	docsCountSuffix: '篇',
	docsArrow: '进入分类 →',
	projectsSection: 'Projects',
	projectsMore: '查看全部项目',
	projectsFeatured: '精选',
	projectsOpen: '查看项目',
	projectsDemo: '含在线演示',
	projectsFallback: '暂时还没有项目。',
	toolsSection: 'Tools',
	toolsMore: '查看全部工具',
	toolsSummaryTitle: '工具区保留，但不再压过主内容。',
	toolsSummaryBody: '它仍然是站点的重要组成部分，只是信息层级上退到文档和最新内容之后，避免首页失焦。',
	toolsSummaryLink: '进入工具列表',
	toolsFallback: '暂时还没有工具。',
};
---

<BaseLayout lang={lang} title="布吉岛 · 首页" description="博客、文档、项目和工具统一整理的个人站点" currentPath="/zh/">
	<HomePage
		lang={lang}
		labels={labels}
		latestPost={featuredPost}
		secondaryPosts={secondaryPosts}
		docsCards={docsOverviewCards}
		featuredProjects={featuredProjects}
		featuredTools={featuredTools}
	/>
</BaseLayout>
