---
import BaseLayout from '../../layouts/BaseLayout.astro';
import HomePage from '../../components/HomePageRedesign.astro';
import { getCollection } from 'astro:content';
const lang = 'en';
const now = (await getCollection('now', (entry) => entry.data.lang === lang && !entry.data.draft)).sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf()).slice(0, 8);
---
<BaseLayout lang={lang} title="Bu Ji Dao · Home" description="The personal website of Bu Ji Dao, covering engineering practice, writing, and ideas." currentPath="/en/" overlayHeader><HomePage lang={lang} now={now} /></BaseLayout>
