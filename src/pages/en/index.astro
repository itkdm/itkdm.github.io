---
import BaseLayout from '../../layouts/BaseLayout.astro';
import HomePage from '../../components/HomePageRedesign.astro';
import { getCollection } from 'astro:content';
const lang = 'en';
const now = (await getCollection('now', (entry) => entry.data.lang === lang && !entry.data.draft)).sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf()).slice(0, 8);
const posts = await getCollection('blog', (entry) => !entry.data.draft);
---
<BaseLayout lang={lang} title="bujidao | AI Agents, Full-Stack Engineering & Open Source" description="Bu Ji Dao's personal website, covering AI agents, full-stack engineering, Java backend, open source projects, and technical writing." currentPath="/en/" overlayHeader footerVariant="closing"><HomePage lang={lang} now={now} posts={posts} /></BaseLayout>
