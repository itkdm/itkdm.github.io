---
import BaseLayout from '../../layouts/BaseLayout.astro';
import HomePage from '../../components/HomePageRedesign.astro';
import { getCollection } from 'astro:content';
import { sortBlogPosts } from '../../lib/blog-sort';
import { sortTools } from '../../lib/tools-sort';

const lang = 'en';
const posts = sortBlogPosts(
	await getCollection('blog', (entry) => entry.data.lang === lang && !entry.data.draft)
);

const pinnedPost = posts.find((post) => (post.data.priority ?? 0) === 9999);
const latestPosts = pinnedPost
	? [pinnedPost, ...posts.filter((p) => p !== pinnedPost).slice(0, 2)]
	: posts.slice(0, 3);

const featuredPost = latestPosts[0];
const secondaryPosts = latestPosts.slice(1, 3);

const docs = await getCollection('docs', (entry) => entry.data.lang === lang);
const projects = (await getCollection('projects', (entry) => entry.data.lang === lang && entry.data.featured !== false)).sort(
	(a, b) => {
		if (a.data.order !== b.data.order) return a.data.order - b.data.order;
		return a.data.title.localeCompare(b.data.title);
	}
);
const tools = sortTools(
	await getCollection('tools', (entry) => entry.data.lang === lang && entry.data.featured !== false)
);

const docsBySection = new Map<string, number>();
for (const doc of docs) {
	const section = (doc.data.section || 'Others').trim();
	docsBySection.set(section, (docsBySection.get(section) ?? 0) + 1);
}

const docsOverviewCards = [
	{
		section: 'Intro',
		description: 'Start here for the site structure, onboarding notes, and the shortest path into the knowledge base.',
		count: docsBySection.get('Intro') ?? 0,
	},
	{
		section: 'Backend',
		description: 'Java, Rust, Go, Python and server-side notes, from overview pages to deeper implementation details.',
		count: docsBySection.get('Backend') ?? 0,
	},
	{
		section: 'Database',
		description: 'MySQL, PostgreSQL and Redis references focused on practical understanding, tradeoffs, and usage.',
		count: docsBySection.get('Database') ?? 0,
	},
];

const featuredProjects = projects.slice(0, 2);
const featuredTools = tools.slice(0, 6);

const labels = {
	heroKicker: 'Personal Knowledge Hub',
	heroTitle: 'One clear homepage for docs, posts, projects, and tools.',
	heroLead: 'The homepage now leads with the knowledge base and recent work instead of giving every card the same weight.',
	heroNote: 'Primary attention goes to docs, fresh writing, and featured builds.',
	primaryAction: { href: '/en/docs/', label: 'Open docs hub' },
	secondaryAction: { href: '/en/blog/', label: 'Read latest posts', style: 'ghost' as const },
	stats: [
		{ label: 'Docs', value: String(docs.length), hint: 'Structured for systematic reading.' },
		{ label: 'Projects', value: String(projects.length), hint: 'Selected practical work and experiments.' },
		{ label: 'Tools', value: String(tools.length), hint: 'Quick utilities you can use directly.' },
	],
	spotlightLabel: 'Start here',
	spotlightTitle: 'New visitors should enter from the docs area first.',
	spotlightBody: 'The redesign pushes the documentation system higher in the hierarchy and gives the homepage a more intentional visual focus.',
	spotlightLink: '/en/docs/',
	latestSection: 'Latest',
	latestMore: 'View all posts',
	latestFeatured: 'Featured',
	latestContinue: 'More to read',
	latestRead: 'Read article',
	latestFallback: 'No posts yet.',
	latestArticleType: 'Blog',
	latestTagFallback: 'Post',
	docsSection: 'Docs',
	docsMore: 'View all docs',
	docsSummaryTitle: 'Docs are now the primary entry point.',
	docsSummaryBody: 'Three key topic cards help visitors understand where to start before they dive into the full documentation tree.',
	docsSummaryLink: 'Browse documentation',
	docsCountSuffix: 'docs',
	docsArrow: 'Open section →',
	projectsSection: 'Projects',
	projectsMore: 'View all projects',
	projectsFeatured: 'Featured',
	projectsOpen: 'Open project',
	projectsDemo: 'Demo available',
	projectsFallback: 'No projects yet.',
	toolsSection: 'Tools',
	toolsMore: 'View all tools',
	toolsSummaryTitle: 'Tools still matter, but they no longer overwhelm the homepage.',
	toolsSummaryBody: 'They remain accessible, just placed behind the core reading and documentation paths so the page feels more focused.',
	toolsSummaryLink: 'Open tools',
	toolsFallback: 'No tools yet.',
};
---

<BaseLayout lang={lang} title="Bu Ji Dao · Home" description="Unified blog, docs, projects and tools with Astro" currentPath="/en/">
	<HomePage
		lang={lang}
		labels={labels}
		latestPost={featuredPost}
		secondaryPosts={secondaryPosts}
		docsCards={docsOverviewCards}
		featuredProjects={featuredProjects}
		featuredTools={featuredTools}
	/>
</BaseLayout>
