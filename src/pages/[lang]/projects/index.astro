---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';
import type { Lang } from '../../../i18n/config';
import { SUPPORTED_LANGS } from '../../../i18n/config';

export function getStaticPaths() {
	return SUPPORTED_LANGS.map((lang) => ({ params: { lang } }));
}

const { lang } = Astro.params as { lang: Lang };
const projects = (await getCollection('projects', (entry) => entry.data.lang === lang)).sort((a, b) => {
	if (a.data.order !== b.data.order) return a.data.order - b.data.order;
	return a.data.title.localeCompare(b.data.title);
});
---

<BaseLayout
	lang={lang}
	title={lang === 'zh' ? '项目' : 'Projects'}
	description={lang === 'zh' ? '个人开源项目与作品集' : 'Personal open-source projects and work'}
	currentPath={`/${lang}/projects/`}
>
	<h1>{lang === 'zh' ? '项目列表' : 'Projects'}</h1>
	{projects.length === 0 ? (
		<p>{lang === 'zh' ? '暂无项目，敬请期待。' : 'No projects yet.'}</p>
	) : (
		<div class="blueprint-grid">
			{projects.map((project) => {
				const projectSlug = project.data.slug ?? project.slug.split('/').pop() ?? project.slug;
				const isFeatured = project.data.featured;
				
				return (
					<div class={`card project-card ${isFeatured ? 'featured' : ''}`} data-slug={projectSlug} data-lang={lang}>
						{/* Decorators */}
						<div class="corner-accents"></div>
						<div class="scan-line"></div>
						
						<div class="card-header">
							<div class="status-indicator">
								<span class="status-dot"></span>
								<span class="status-text">{isFeatured ? 'PRIORITY' : 'ACTIVE'}</span>
							</div>
							<div class="tech-id">#{projectSlug.substring(0, 6).toUpperCase()}</div>
						</div>
						
						<div class="card-content">
							<h3 class="project-title">
								{project.data.icon && <span class="project-icon">{project.data.icon}</span>}
								{project.data.title}
							</h3>
							
							<p class="description">{project.data.summary}</p>
							
							{project.data.tags.length > 0 && (
								<div class="tech-stack">
									<div class="tags">
										<span class="stack-prefix">&gt; STACK:</span>
										{project.data.tags.map(tag => <span class="tech-tag">{tag}</span>)}
									</div>
								</div>
							)}
						</div>

						<div class="card-footer project-actions">
							<button 
								class="action-btn primary"
								data-repo={project.data.repo}
								title="View Source Code"
							>
								<span class="btn-icon">GH</span>
								<span class="btn-text">SOURCE</span>
							</button>
							
							{project.data.demo && (
								<button 
									class="action-btn secondary"
									data-demo={project.data.demo}
									title="Launch Demo"
								>
									<span class="btn-icon">RUN</span>
									<span class="btn-text">DEPLOY</span>
								</button>
							)}
						</div>
					</div>
				);
			})}
		</div>
		<style>
			/* 
			 * THEME: INDUSTRIAL BLUEPRINT 
			 * CONCEPT: Precision, Engineering, CAD Interface
			 */
			
			.blueprint-grid {
				display: grid;
				grid-template-columns: repeat(auto-fill, minmax(340px, 1fr));
				gap: 24px;
				padding: 20px 0;
			}

			/* Card Base */
			.project-card {
				position: relative;
				background: var(--bg-soft);
				border: 1px solid var(--border-strong);
				border-radius: 4px; /* Industrial sharp/small radius */
				padding: 0;
				overflow: hidden;
				transition: all 0.3s cubic-bezier(0.23, 1, 0.32, 1);
				display: flex;
				flex-direction: column;
				height: 100%;
				/* Grid background for technical feel */
				background-image: 
					linear-gradient(var(--border) 1px, transparent 1px),
					linear-gradient(90deg, var(--border) 1px, transparent 1px);
				background-size: 20px 20px;
				background-position: center;
				box-shadow: none;
			}
			
			.project-card:hover {
				border-color: var(--primary);
				box-shadow: 0 8px 30px rgba(0, 0, 0, 0.08);
				transform: translateY(-2px);
			}

			/* Corner Accents (The "Frame" look) */
			.corner-accents::before,
			.corner-accents::after {
				content: '';
				position: absolute;
				width: 12px;
				height: 12px;
				border: 2px solid transparent;
				transition: all 0.3s ease;
				opacity: 0.5;
				pointer-events: none;
			}

			.corner-accents::before {
				top: -1px;
				left: -1px;
				border-top-color: var(--text-muted);
				border-left-color: var(--text-muted);
			}

			.corner-accents::after {
				bottom: -1px;
				right: -1px;
				border-bottom-color: var(--text-muted);
				border-right-color: var(--text-muted);
			}

			.project-card:hover .corner-accents::before,
			.project-card:hover .corner-accents::after {
				width: 100%;
				height: 100%;
				border-color: var(--primary);
				opacity: 1;
			}

			/* Scan Line Effect */
			.project-card:hover .scan-line {
				position: absolute;
				top: 0;
				left: 0;
				width: 100%;
				height: 100%;
				background: linear-gradient(to bottom, transparent, rgba(11, 91, 110, 0.05), transparent);
				animation: scan 1.5s linear infinite;
				pointer-events: none;
				z-index: 0;
			}

			@keyframes scan {
				0% { transform: translateY(-100%); }
				100% { transform: translateY(100%); }
			}

			/* Layout Sections */
			.card-header {
				display: flex;
				justify-content: space-between;
				align-items: center;
				padding: 12px 16px;
				border-bottom: 1px solid var(--border);
				background: var(--bg);
				font-family: var(--mono);
				font-size: 0.75rem;
				letter-spacing: 0.05em;
				z-index: 1;
			}

			.card-content {
				padding: 24px 20px;
				flex: 1;
				background: var(--glass-surface); /* Use themed glass effect */
				backdrop-filter: blur(2px);
				z-index: 1;
			}

			.card-footer {
				padding: 12px 16px;
				border-top: 1px solid var(--border);
				background: var(--bg);
				display: flex;
				gap: 12px;
				z-index: 1;
			}

			/* Elements */
			.status-indicator {
				display: flex;
				align-items: center;
				gap: 6px;
			}
			
			.status-dot {
				width: 6px;
				height: 6px;
				background: var(--code-comment); /* Use green/success color */
				border-radius: 50%;
				box-shadow: 0 0 4px var(--code-comment);
			}
			
			.featured .status-dot {
				background: var(--a-500); /* Orange for priority */
				box-shadow: 0 0 4px var(--a-500);
			}

			.status-text {
				color: var(--text-muted);
				font-weight: 600;
			}

			.tech-id {
				color: var(--text-faint);
				opacity: 0.7;
			}

			.project-title {
				margin: 0 0 12px 0;
				font-size: 1.25rem;
				font-weight: 700;
				display: flex;
				align-items: center;
				gap: 8px;
				letter-spacing: -0.02em;
				color: var(--text);
			}

			.project-icon {
				font-size: 1.4em;
				line-height: 1;
			}

			.description {
				font-size: 0.925rem;
				color: var(--text-muted);
				line-height: 1.6;
				margin-bottom: 20px;
			}

			/* Tech Stack Chips */
			.tech-stack {
				margin-top: auto;
				padding-top: 16px;
				border-top: 1px dashed var(--border);
			}

			.tags {
				display: flex;
				flex-wrap: wrap;
				align-items: baseline;
				gap: 6px;
				font-family: var(--mono);
				font-size: 0.75rem;
			}

			.stack-prefix {
				color: var(--text-faint);
				font-size: 0.7rem;
				margin-right: 4px;
				opacity: 0.8;
			}

			.tech-tag {
				padding: 2px 6px;
				background: var(--bg-soft);
				color: var(--text-muted);
				border: 1px solid var(--border-strong);
				border-radius: 4px;
				transition: all 0.2s ease;
				position: relative;
			}
			
			.tech-tag:hover {
				color: var(--primary);
				border-color: var(--primary);
				background: var(--primary-soft);
			}

			/* Buttons: Industrial Switches */
			.action-btn {
				flex: 1;
				display: flex;
				align-items: center;
				justify-content: center;
				gap: 8px;
				padding: 8px;
				background: transparent;
				border: 1px solid var(--border-strong);
				color: var(--text-muted);
				font-family: var(--mono);
				font-size: 0.8rem;
				cursor: pointer;
				transition: all 0.2s ease;
				position: relative;
				overflow: hidden;
				border-radius: 2px;
			}

			.action-btn::before {
				content: '';
				position: absolute;
				top: 0;
				left: 0;
				width: 2px;
				height: 100%;
				background: var(--text-muted);
				transition: width 0.2s ease;
				z-index: 0;
			}

			.action-btn:hover {
				color: var(--bg);
				border-color: var(--text-muted);
			}

			.action-btn:hover::before {
				width: 100%;
			}

			.action-btn .btn-text,
			.action-btn .btn-icon {
				position: relative;
				z-index: 1;
				font-weight: 600;
			}
			
			.action-btn.primary:hover::before {
				background: var(--text); /* Dark background on hover */
			}

			.action-btn.secondary:hover {
				color: var(--primary);
				border-color: var(--primary);
			}
			.action-btn.secondary:hover::before {
				background: rgba(var(--primary-rgb, 100,100,100), 0.1); 
				width: 100%;
			}
			/* Different hover style for secondary to keep it distinct */
			.action-btn.secondary:hover .btn-text {
				color: var(--primary);
			}
		</style>
		<script>
			// Interact Logic
			document.querySelectorAll('.project-card').forEach(card => {
				const slug = card.dataset.slug;
				const lang = card.dataset.lang;
				
				// Main Card Click
				card.addEventListener('click', (e) => {
					// Ignore if clicking action buttons
					if (e.target.closest('.project-actions')) return;
					window.location.href = `/${lang}/projects/${slug}/`;
				});
				
				// Hover Sound Effect (Optional - maybe too much? kept simple visual only for now)
				
				// Buttons
				const repoBtn = card.querySelector('[data-repo]');
				if (repoBtn) {
					repoBtn.addEventListener('click', (e) => {
						e.stopPropagation();
						window.open(repoBtn.dataset.repo, '_blank');
					});
				}
				
				const demoBtn = card.querySelector('[data-demo]');
				if (demoBtn) {
					demoBtn.addEventListener('click', (e) => {
						e.stopPropagation();
						window.open(demoBtn.dataset.demo, '_blank');
					});
				}
			});
		</script>
	)}
</BaseLayout>
