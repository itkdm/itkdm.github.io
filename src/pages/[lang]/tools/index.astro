---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';
import type { Lang } from '../../../i18n/config';
import { SUPPORTED_LANGS } from '../../../i18n/config';
import { sortTools } from '../../../lib/tools-sort';

export function getStaticPaths() {
	return SUPPORTED_LANGS.map((lang) => ({ params: { lang } }));
}

const { lang } = Astro.params as { lang: Lang };
const rawTools = sortTools(
	await getCollection('tools', (entry) => entry.data.lang === lang)
);

// --- 自动分类逻辑 ---
// 根据工具的 tags 或 name 自动归类
const CATEGORIES = {
	zh: {
		'dev': { label: '开发与转换', keywords: ['json', 'xml', 'base64', 'url', 'hash', '编码', '解码', '格式化', '转换', 'html', 'csv'] },
		'text': { label: '文本处理', keywords: ['text', 'regex', 'diff', 'dedupe', 'sort', 'replace', '文本', '正则', '去重', '对比', '统计'] },
		'media': { label: '图片与媒体', keywords: ['image', 'qr', 'color', 'media', '图片', '二维码', '颜色', '表情'] },
		'generator': { label: '生成器', keywords: ['password', 'uuid', 'random', 'timestamp', 'generator', '生成', '随机', '密码'] },
		'other': { label: '其他工具', keywords: [] } // Fallback
	},
	en: {
		'dev': { label: 'Dev & Convert', keywords: ['json', 'xml', 'base64', 'url', 'hash', 'encode', 'decode', 'format', 'convert', 'html', 'csv'] },
		'text': { label: 'Text Tools', keywords: ['text', 'regex', 'diff', 'dedupe', 'sort', 'replace', 'stats'] },
		'media': { label: 'Media & Design', keywords: ['image', 'qr', 'color', 'media'] },
		'generator': { label: 'Generators', keywords: ['password', 'uuid', 'random', 'timestamp', 'generator'] },
		'other': { label: 'Utilities', keywords: [] }
	}
};

const currentCats = CATEGORIES[lang];

// 为每个工具分配分类
const tools = rawTools.map(tool => {
	const searchText = `${tool.data.name} ${tool.data.tags?.join(' ') || ''}`.toLowerCase();
	let category = 'other';
	
	for (const [key, config] of Object.entries(currentCats)) {
		if (key === 'other') continue;
		if (config.keywords.some(k => searchText.includes(k))) {
			category = key;
			break;
		}
	}
	return { ...tool, category };
});

const allCategories = Object.keys(currentCats).filter(cat => {
	// 只显示有工具的分类
	return tools.some(t => t.category === cat);
});
---

<BaseLayout
	lang={lang}
	title={lang === 'zh' ? '工具箱' : 'Toolbox'}
	description={lang === 'zh' ? '开发者实用工具集合' : 'Developer utility collection'}
	currentPath={`/${lang}/tools/`}
>
	<div class="toolbox-header">
		<h1>{lang === 'zh' ? '工具箱' : 'Toolbox'}</h1>
		<p class="subtitle">{lang === 'zh' ? '高频开发者工具集合，即开即用。' : 'Collection of high-frequency developer tools.'}</p>
	</div>

	<div class="control-panel">
		<div class="filter-bar">
			<button class="filter-chip active" data-filter="all">
				<span class="icon">⚡</span>
				{lang === 'zh' ? '全部' : 'All'}
			</button>
			{allCategories.map(cat => (
				<button class="filter-chip" data-filter={cat}>
					{currentCats[cat].label}
				</button>
			))}
		</div>

		<div class="search-module">
			<div class="search-input-wrapper">
				<span class="prompt">&gt;</span>
				<input 
					type="text" 
					id="tools-search-input" 
					placeholder={lang === 'zh' ? '输入指令或关键字搜索...' : 'Type command or keywords...'}
					autocomplete="off"
				/>
				<span class="cursor">_</span>
			</div>
		</div>
	</div>

	{tools.length === 0 ? (
		<div class="empty-state">
			<p>{lang === 'zh' ? '暂无工具条目。' : 'No tools yet.'}</p>
		</div>
	) : (
		<>
			<div class="tools-grid-wrapper">
				{allCategories.map(cat => (
					<div class="category-section" data-category={cat}>
						<div class="category-header">
							<span class="hash">#</span>
							<h2>{currentCats[cat].label}</h2>
							<div class="line"></div>
						</div>
						<div class="grid grid-3 tools-grid">
							{tools.filter(t => t.category === cat).map((tool) => {
								const searchText = `${tool.data.name} ${tool.data.summary} ${(tool.data.tags || []).join(' ')}`.toLowerCase();
								return (
									<div class="card tool-card" data-category={cat} data-search={searchText} onclick={`window.open('${tool.data.homepage}', '${tool.data.homepage.startsWith('http') ? '_blank' : '_self'}')`}>
										<div class="tool-icon-wrapper">
											<span class="tool-icon">{tool.data.icon || '🛠️'}</span>
										</div>
										<div class="tool-info">
											<div class="tool-header">
												<h3>{tool.data.name}</h3>
							{tool.data.featured && <span class="badge-mini">{lang === 'zh' ? '热门' : 'HOT'}</span>}
											</div>
											<p class="tool-desc">{tool.data.summary}</p>
											<div class="tool-meta">
								<span class="tool-pill">{lang === 'zh' ? '打开' : 'RUN'}</span>
												{tool.data.tags && tool.data.tags.slice(0, 2).map((tag) => (
													<span class="tool-tag">{tag}</span>
												))}
											</div>
										</div>
										<div class="hover-overlay"></div>
									</div>
								);
							})}
						</div>
					</div>
				))}
			</div>
			
			<div id="no-results" class="no-results" style="display: none;">
				<div class="console-msg">
					{lang === 'zh' ? <><span class="suggestion">未找到匹配的工具。</span><br/><span class="suggestion">请尝试其他关键词或检查输入内容。</span></> : <><span class="error">ERROR:</span> No matching tools found. <br/><span class="suggestion">Try different keywords or check spelling.</span></>}
				</div>
			</div>
		</>
	)}
</BaseLayout>

<style>
/* 
 * THEME: UTILITY DASHBOARD
 * CONCEPT: Control Panel, HUD, High Density
 */

.toolbox-header {
	margin-bottom: 32px;
}

.subtitle {
	color: var(--text-muted);
	font-size: 1.1rem;
	margin-top: 8px;
}

/* Control Panel (Filter + Search) */
.control-panel {
	background: var(--bg-soft);
	border: 1px solid var(--border-strong);
	border-radius: 8px;
	padding: 16px;
	margin-bottom: 32px;
	display: flex;
	justify-content: space-between;
	align-items: center;
	gap: 20px;
	flex-wrap: wrap;
	box-shadow: var(--shadow-1);
}

.filter-bar {
	display: flex;
	gap: 8px;
	flex-wrap: wrap;
}

.filter-chip {
	background: var(--bg);
	border: 1px solid var(--border);
	color: var(--text-muted);
	padding: 6px 14px;
	border-radius: 4px;
	font-size: 0.9rem;
	cursor: pointer;
	transition: all 0.2s ease;
	font-family: var(--sans);
	font-weight: 500;
	display: flex;
	align-items: center;
	gap: 6px;
}

.filter-chip:hover {
	border-color: var(--border-strong);
	color: var(--text);
	transform: translateY(-1px);
}

.filter-chip.active {
	background: var(--primary-soft);
	color: var(--primary);
	border-color: var(--primary);
	box-shadow: 0 0 0 1px var(--primary-soft);
}

/* Search Module (Terminal Style) */
.search-module {
	flex: 1;
	min-width: 250px;
}

.search-input-wrapper {
	display: flex;
	align-items: center;
	background: var(--bg); /* Darker background for input */
	border: 1px solid var(--border-strong);
	border-radius: 4px;
	padding: 8px 12px;
	font-family: var(--mono);
	position: relative;
	transition: border-color 0.2s ease;
}

.search-input-wrapper:focus-within {
	border-color: var(--primary);
	box-shadow: 0 0 0 2px var(--primary-soft);
}

.prompt {
	color: var(--success);
	margin-right: 8px;
	font-weight: bold;
}

#tools-search-input {
	border: none;
	background: transparent;
	width: 100%;
	color: var(--text);
	font-family: var(--mono);
	font-size: 0.9rem;
	outline: none;
}

.cursor {
	color: var(--primary);
	animation: blink 1s step-end infinite;
}

@keyframes blink {
	50% { opacity: 0; }
}

/* Category Sections */
.category-section {
	margin-bottom: 40px;
	animation: fadeIn 0.4s ease forwards;
}

.category-header {
	display: flex;
	align-items: center;
	gap: 12px;
	margin-bottom: 16px;
	opacity: 0.8;
}

.category-header .hash {
	color: var(--primary);
	font-family: var(--mono);
	font-weight: bold;
}

.category-header h2 {
	font-size: 1.25rem;
	margin: 0;
	color: var(--text);
	font-weight: 600;
}

.category-header .line {
	flex: 1;
	height: 1px;
	background: var(--border);
	opacity: 0.5;
}

/* Tool Cards */
.tools-grid {
	display: grid;
	grid-template-columns: repeat(auto-fill, minmax(300px, 1fr));
	gap: 16px;
}

.tool-card {
	position: relative;
	display: flex;
	flex-direction: row; /* Horizontal layout */
	gap: 16px;
	padding: 16px;
	background: var(--bg-elev);
	border: 1px solid var(--border);
	border-radius: 6px;
	cursor: pointer;
	transition: all 0.25s cubic-bezier(0.2, 0.8, 0.2, 1);
	overflow: hidden;
	height: 100%;
	align-items: flex-start;
}

.tool-card:hover {
	border-color: var(--primary);
	transform: translateY(-2px);
	box-shadow: var(--shadow-1);
}

.tool-icon-wrapper {
	width: 42px;
	height: 42px;
	background: var(--bg-soft);
	border-radius: 6px;
	display: flex;
	align-items: center;
	justify-content: center;
	font-size: 1.5rem;
	flex-shrink: 0;
	border: 1px solid var(--border);
}

.tool-info {
	flex: 1;
	min-width: 0; /* Prevent flexitem overflow */
	display: flex;
	flex-direction: column;
	height: 100%;
}

.tool-header {
	display: flex;
	justify-content: space-between;
	align-items: center;
	margin-bottom: 4px;
}

.tool-header h3 {
	margin: 0;
	font-size: 1rem;
	font-weight: 600;
	color: var(--text);
	white-space: nowrap;
	overflow: hidden;
	text-overflow: ellipsis;
}

.badge-mini {
	font-size: 0.6rem;
	background: var(--accent);
	color: white;
	padding: 1px 4px;
	border-radius: 2px;
	font-weight: bold;
	font-family: var(--mono);
}

.tool-desc {
	font-size: 0.85rem;
	color: var(--text-muted);
	margin: 0 0 12px 0;
	line-height: 1.4;
	display: -webkit-box;
	-webkit-line-clamp: 2;
	-webkit-box-orient: vertical;
	overflow: hidden;
	flex: 1; /* Push meta down */
}

.tool-meta {
	display: flex;
	align-items: center;
	gap: 8px;
	margin-top: auto;
}

.tool-pill {
	font-family: var(--mono);
	font-size: 0.7rem;
	background: var(--primary-soft);
	color: var(--primary);
	padding: 2px 6px;
	border-radius: 3px;
	font-weight: 600;
	text-transform: uppercase;
}

.tool-tag {
	font-size: 0.7rem;
	color: var(--text-faint);
	background: var(--bg-soft);
	padding: 2px 6px;
	border-radius: 3px;
}

/* Hover Effect */
.tool-card:hover .tool-pill {
	background: var(--primary);
	color: white;
}

/* No Results */
.no-results {
	padding: 60px;
	text-align: center;
	background: var(--bg-soft);
	border: 1px dashed var(--border-strong);
	border-radius: 8px;
}

.console-msg {
	font-family: var(--mono);
	color: var(--text-muted);
}

.error {
	color: var(--accent);
	font-weight: bold;
}

.suggestion {
	color: var(--text-faint);
	font-size: 0.9rem;
	display: block;
	margin-top: 8px;
}

@keyframes fadeIn {
	from { opacity: 0; transform: translateY(10px); }
	to { opacity: 1; transform: translateY(0); }
}

@media (max-width: 768px) {
	.control-panel {
		flex-direction: column;
		align-items: stretch;
	}
	
	.filter-bar {
		overflow-x: auto;
		padding-bottom: 8px;
		/* Hide scrollbar */
		-ms-overflow-style: none;
		scrollbar-width: none;
	}
	
	.filter-bar::-webkit-scrollbar {
		display: none;
	}
}
</style>

<script>
	document.addEventListener('DOMContentLoaded', () => {
		const searchInput = document.getElementById('tools-search-input');
		const filterChips = document.querySelectorAll('.filter-chip');
		const categorySections = document.querySelectorAll('.category-section');
		const toolCards = document.querySelectorAll('.tool-card');
		const noResults = document.getElementById('no-results');
		
		let activeCategory = 'all';
		let searchQuery = '';

		// Filter Logic
		function applyFilters() {
			let visibleCount = 0;
			let visibleCategories = new Set();

			toolCards.forEach(card => {
				const cardCat = card.getAttribute('data-category');
				const cardSearch = card.getAttribute('data-search');
				
				const matchesCategory = activeCategory === 'all' || activeCategory === cardCat;
				const matchesSearch = !searchQuery || cardSearch.includes(searchQuery);

				if (matchesCategory && matchesSearch) {
					card.style.display = 'flex';
					card.parentElement.style.display = 'grid'; // Ensure grid parent is visible
					visibleCategories.add(cardCat);
					visibleCount++;
				} else {
					card.style.display = 'none';
				}
			});

			// Hide empty category sections
			categorySections.forEach(section => {
				const sectionCat = section.getAttribute('data-category');
				if (visibleCategories.has(sectionCat)) {
					section.style.display = 'block';
				} else {
					section.style.display = 'none';
				}
			});

			// Show/Hide No Results
			if (noResults) {
				noResults.style.display = visibleCount === 0 ? 'block' : 'none';
			}
		}

		// Event Listeners
		filterChips.forEach(chip => {
			chip.addEventListener('click', () => {
				// Toggle active class
				filterChips.forEach(c => c.classList.remove('active'));
				chip.classList.add('active');
				
				activeCategory = chip.getAttribute('data-filter');
				applyFilters();
			});
		});

		searchInput?.addEventListener('input', (e) => {
			// @ts-ignore
			searchQuery = e.target.value.trim().toLowerCase();
			applyFilters();
		});
	});
