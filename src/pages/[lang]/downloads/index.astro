---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import type { Lang } from '../../../i18n/config';
import { SUPPORTED_LANGS } from '../../../i18n/config';
import releases from '../../../generated/releases.json';
import { renderMarkdown } from '../../../lib/markdown-render';
import DownloadSourceIcon from '../../../components/DownloadSourceIcon.astro';
import type { DownloadTool, DownloadSource, GitHubDownloadSource, CloudDiskDownloadSource } from '../../../types/downloads';

export function getStaticPaths() {
	return SUPPORTED_LANGS.map((lang) => ({ params: { lang } }));
}

const { lang } = Astro.params as { lang: Lang };
const tools = (releases.tools ?? []) as DownloadTool[];
const site = Astro.site?.href ?? 'https://itkdm.com';
const canonical = new URL(`/${lang}/downloads/`, site).href;
const jsonLd = {
	'@context': 'https://schema.org',
	'@type': 'CollectionPage',
	name: lang === 'zh' ? '下载中心' : 'Downloads',
	description:
		lang === 'zh'
			? '下载中心 - 支持多种下载方式'
			: 'Download center - Multiple download options',
	inLanguage: lang,
	url: canonical,
};

// 获取下载源类型标签
function getSourceTypeLabel(type: string): string {
	const labels: Record<string, { zh: string; en: string }> = {
		direct: { zh: '直接下载', en: 'Direct Download' },
		github: { zh: 'GitHub Release', en: 'GitHub Release' },
		baidu: { zh: '百度网盘', en: 'Baidu Netdisk' },
		quark: { zh: '夸克网盘', en: 'Quark Netdisk' },
		aliyun: { zh: '阿里云盘', en: 'Aliyun Drive' },
		other: { zh: '其他网盘', en: 'Other Cloud Disk' },
	};
	return labels[type]?.[lang] || type;
}


// Format asset size for display.
function formatSize(bytes?: number): string {
	if (!bytes) return '';
	const mb = bytes / 1024 / 1024;
	if (mb >= 1) {
		return `${mb.toFixed(1)} MB`;
	}
	return `${(bytes / 1024).toFixed(1)} KB`;
}

function getLatestVersion(tool: DownloadTool): string | undefined {
	const githubSource = tool.sources?.find((s) => s.type === 'github' && (s as GitHubDownloadSource).latest) as GitHubDownloadSource | undefined;
	return githubSource?.latest?.version;
}

function isGitHubSource(source: DownloadSource): source is GitHubDownloadSource {
	return source.type === 'github' && 'latest' in source;
}
---

<BaseLayout
	lang={lang}
	title={lang === 'zh' ? '下载中心' : 'Downloads'}
	description={lang === 'zh' ? '软件发布与资源下载' : 'Software releases and resources'}
	currentPath={`/${lang}/downloads/`}
	jsonLd={jsonLd}
>
	<div class="repo-header">
		<div class="header-content">
			<h1>{lang === 'zh' ? '资源仓库' : 'Artifacts'}</h1>
			<p class="subtitle">
				{lang === 'zh' 
					? '软件发行版 / 配置文件 / 说明文档' 
					: 'Software Releases / Configs / Documentation'}
			</p>
		</div>
		<div class="repo-stats">
			<div class="stat-item">
				<span class="stat-value">{tools.length}</span>
				<span class="stat-label">ITEMS</span>
			</div>
		</div>
	</div>

	<div class="control-panel">
		<div class="search-module">
			<div class="search-input-wrapper">
				<span class="prompt">$ find</span>
				<input
					type="text"
					id="downloadSearchInput"
					class="search-input"
					placeholder={lang === 'zh' ? '输入名称或版本号搜索...' : 'Search by name or version...'}
					autocomplete="off"
				/>
				<span class="cursor">_</span>
			</div>
		</div>
	</div>

	<div id="downloadResults" class="download-grid">
		{tools.length === 0 ? (
			<div class="empty-state">
				<p>{lang === 'zh' ? '仓库暂无资源。' : 'Repository empty.'}</p>
			</div>
		) : (
			tools.map((tool) => (
				<div class="card cartridge-card" id={tool.id} data-search={`${tool.name} ${tool.nameEn || ''} ${tool.description} ${tool.descriptionEn || ''}`.toLowerCase()}>
					
					<!-- Decorative Header -->
					<div class="cartridge-header">
						<span class="id-code">ID: {tool.id.toUpperCase().substring(0, 8)}</span>
						<div class="dots">
							<span></span><span></span><span></span>
						</div>
					</div>

					<div class="cartridge-body">
						<div class="item-visual">
							{tool.icon ? (
								<div class="app-icon">{tool.icon}</div>
							) : (
								<div class="app-icon placeholder">📦</div>
							)}
						</div>
						
						<div class="item-info">
							<h2>{lang === 'zh' ? tool.name : tool.nameEn || tool.name}</h2>
							<p class="desc">{lang === 'zh' ? tool.description : tool.descriptionEn || tool.description}</p>
							
							<!-- Latest Version Badge -->
							{getLatestVersion(tool) && (
								<div class="version-badge">
									<span class="v-label">LATEST:</span>
									<span class="v-num">
										{getLatestVersion(tool)}
									</span>
								</div>
							)}
						</div>
					</div>

					<!-- Download Sources Section -->
					<div class="cartridge-footer">
						<div class="sources-list">
							{tool.sources && tool.sources.length > 0 ? (
								tool.sources.map((source) => {
									if (isGitHubSource(source) && source.latest) {
										const assets = source.latest.assets || [];
										
										return (
											<div class="source-block github">
												<div class="source-title">
													<span class="gh-icon">GH_RELEASE</span>
													<span class="date">
														{source.latest.publishedAt && new Date(source.latest.publishedAt).toLocaleDateString()}
													</span>
												</div>
												<div class="assets-grid">
													{assets.map((asset) => (
														<a href={asset.downloadUrl} class="asset-btn" target="_blank">
															<span class="asset-name">{asset.name}</span>
															<span class="asset-size">{formatSize(asset.size)}</span>
														</a>
													))}
												</div>
												{source.latest.notes && (
													<details class="release-notes">
														<summary>{lang === 'zh' ? '更新日志' : 'Changelog'}</summary>
														<div class="notes-content" set:html={renderMarkdown(source.latest.notes)}></div>
													</details>
												)}
											</div>
										);
									}
									
									// Direct / Cloud Disk
									const cloudSource = source as CloudDiskDownloadSource;
									const name = cloudSource.name || getSourceTypeLabel(cloudSource.type);
									return (
										<div class="source-block cloud">
											<div class="source-title">
												<span>{source.type.toUpperCase()}</span>
											</div>
											<div class="cloud-actions">
												{['baidu', 'quark', 'aliyun'].includes(source.type) ? (
													<div class="cloud-link-group">
														<a href={cloudSource.url} target="_blank" class="cloud-btn">
															<DownloadSourceIcon type={source.type} />
															<span>{name}</span>
														</a>
														{cloudSource.code && (
															<div class="access-code" onclick={`navigator.clipboard.writeText('${cloudSource.code}')`}>
																<code>Code: {cloudSource.code}</code>
																<span class="tip">{lang === 'zh' ? '(点击复制)' : '(Copy)'}</span>
															</div>
														)}
													</div>
												) : (
													<a href={(source as any).url} target="_blank" class="cloud-btn direct">
														<DownloadSourceIcon type={source.type} />
														<span>{name}</span>
													</a>
												)}
											</div>
										</div>
									);
								})
							) : (
								<div class="no-source">{lang === 'zh' ? '暂无资源' : 'No sources'}</div>
							)}
						</div>
					</div>
				</div>
			))
		)}
	</div>

	<div id="downloadNoResults" class="no-results" style="display: none;">
		<p>{lang === 'zh' ? '未找到匹配的资源。' : 'Artifact not found.'}</p>
	</div>
</BaseLayout>

<style>
	/* 
	 * THEME: REPOSITORY / ARCHIVE
	 * STYLE: Industrial, Structured, Data-heavy
	 */

	.repo-header {
		display: flex;
		justify-content: space-between;
		align-items: flex-end;
		margin-bottom: 32px;
		padding-bottom: 16px;
		border-bottom: 2px solid var(--border);
	}

	.subtitle {
		color: var(--text-muted);
		font-family: var(--mono);
		font-size: 0.9rem;
		margin-top: 8px;
		opacity: 0.8;
	}

	.repo-stats {
		display: flex;
		gap: 16px;
	}

	.stat-item {
		text-align: right;
		font-family: var(--mono);
	}

	.stat-value {
		display: block;
		font-size: 1.5rem;
		font-weight: bold;
		color: var(--primary);
	}

	.stat-label {
		font-size: 0.7rem;
		color: var(--text-faint);
		letter-spacing: 1px;
	}

	/* Search */
	.control-panel {
		margin-bottom: 32px;
	}

	.search-input-wrapper {
		display: flex;
		align-items: center;
		background: var(--bg-soft);
		border: 1px solid var(--border-strong);
		border-radius: 4px;
		padding: 10px 16px;
		font-family: var(--mono);
	}

	.search-input-wrapper:focus-within {
		border-color: var(--primary);
		box-shadow: 0 0 0 1px var(--primary-soft);
	}

	.prompt {
		color: var(--accent);
		margin-right: 12px;
		font-weight: bold;
		user-select: none;
	}

	.search-input {
		flex: 1;
		background: transparent;
		border: none;
		color: var(--text);
		font-family: var(--mono);
		outline: none;
		font-size: 0.95rem;
	}

	.cursor {
		color: var(--primary);
		animation: blink 1s step-end infinite;
		font-weight: bold;
	}

	@keyframes blink { 50% { opacity: 0; } }

	/* Grid */
	.download-grid {
		display: grid;
		grid-template-columns: repeat(auto-fill, minmax(350px, 1fr));
		gap: 24px;
	}

	/* Cartridge Card */
	.cartridge-card {
		background: var(--bg-elev);
		border: 1px solid var(--border);
		border-radius: 6px;
		overflow: hidden;
		display: flex;
		flex-direction: column;
		transition: all 0.2s ease;
		position: relative;
	}

	.cartridge-card:hover {
		border-color: var(--primary);
		transform: translateY(-2px);
		box-shadow: var(--shadow-1);
	}
	
	.cartridge-card::before {
		content: '';
		position: absolute;
		top: 0;
		left: 0;
		bottom: 0;
		width: 4px;
		background: var(--border);
		transition: background 0.2s ease;
	}

	.cartridge-card:hover::before {
		background: var(--primary);
	}

	/* Card Header */
	.cartridge-header {
		background: var(--bg-soft);
		padding: 8px 12px 8px 20px; /* Left padding for strip */
		border-bottom: 1px solid var(--border);
		display: flex;
		justify-content: space-between;
		align-items: center;
		font-family: var(--mono);
		font-size: 0.7rem;
		color: var(--text-faint);
	}

	.dots span {
		display: inline-block;
		width: 4px;
		height: 4px;
		background: var(--border-strong);
		border-radius: 50%;
		margin-left: 3px;
	}

	.cartridge-card:hover .dots span {
		background: var(--primary);
	}

	/* Card Body */
	.cartridge-body {
		padding: 20px 20px 20px 24px;
		display: flex;
		gap: 16px;
		align-items: flex-start;
	}

	.app-icon {
		font-size: 2rem;
		width: 48px;
		height: 48px;
		display: flex;
		align-items: center;
		justify-content: center;
		background: var(--bg-soft);
		border: 1px solid var(--border);
		border-radius: 8px;
	}
	
	.item-info {
		flex: 1;
		min-width: 0;
	}

	.item-info h2 {
		margin: 0 0 6px 0;
		font-size: 1.1rem;
		font-weight: 700;
	}

	.desc {
		font-size: 0.85rem;
		color: var(--text-muted);
		margin: 0 0 12px 0;
		line-height: 1.5;
	}

	.version-badge {
		display: inline-flex;
		align-items: center;
		background: var(--bg-soft);
		border: 1px solid var(--border);
		border-radius: 4px;
		padding: 2px 6px;
		font-family: var(--mono);
		font-size: 0.7rem;
	}

	.v-label {
		color: var(--text-faint);
		margin-right: 4px;
	}

	.v-num {
		color: var(--success);
		font-weight: bold;
	}

	/* Footer / Sources */
	.cartridge-footer {
		padding: 0 20px 20px 24px;
		flex: 1;
		display: flex;
		flex-direction: column;
	}

	.sources-list {
		display: flex;
		flex-direction: column;
		gap: 12px;
		padding-top: 16px;
		border-top: 1px dashed var(--border);
		margin-top: auto;
	}

	.source-block {
		font-size: 0.85rem;
	}

	.source-title {
		font-family: var(--mono);
		font-size: 0.7rem;
		color: var(--text-faint);
		margin-bottom: 6px;
		display: flex;
		justify-content: space-between;
	}

	/* GitHub Assets */
	.assets-grid {
		display: grid;
		grid-template-columns: repeat(auto-fit, minmax(140px, 1fr));
		gap: 8px;
	}

	.asset-btn {
		display: flex;
		flex-direction: column;
		padding: 6px 10px;
		background: var(--bg);
		border: 1px solid var(--border-strong);
		border-radius: 4px;
		text-decoration: none;
		transition: all 0.2s;
	}

	.asset-btn:hover {
		border-color: var(--primary);
		background: var(--bg-soft);
	}

	.asset-name {
		font-weight: 500;
		color: var(--text);
		white-space: nowrap;
		overflow: hidden;
		text-overflow: ellipsis;
		font-size: 0.8rem;
	}

	.asset-size {
		font-family: var(--mono);
		font-size: 0.7rem;
		color: var(--text-muted);
		margin-top: 2px;
	}

	.release-notes {
		margin-top: 8px;
	}

	.release-notes summary {
		cursor: pointer;
		font-size: 0.75rem;
		color: var(--text-muted);
	}
	
	.notes-content {
		margin-top: 8px;
		padding: 8px;
		background: var(--bg-soft);
		font-size: 0.8rem;
		border-radius: 4px;
		max-height: 150px;
		overflow-y: auto;
	}

	/* Cloud Actions */
	.cloud-actions {
		display: flex;
		flex-wrap: wrap;
		gap: 8px;
	}

	.cloud-link-group {
		display: flex;
		align-items: center;
		background: var(--bg-soft);
		border: 1px solid var(--border);
		border-radius: 4px;
		padding: 2px;
	}

	.cloud-btn {
		display: flex;
		align-items: center;
		gap: 6px;
		padding: 4px 10px;
		text-decoration: none;
		color: var(--text);
		font-size: 0.8rem;
		font-weight: 500;
		border-radius: 3px;
	}
	
	.cloud-btn.direct {
		background: var(--bg-soft);
		border: 1px solid var(--border);
	}
	
	.cloud-btn.direct:hover {
		border-color: var(--primary);
		color: var(--primary);
	}

	.access-code {
		display: flex;
		align-items: center;
		gap: 6px;
		background: var(--bg-elev);
		border-left: 1px solid var(--border);
		padding: 4px 8px;
		font-family: var(--mono);
		font-size: 0.75rem;
		color: var(--accent);
		cursor: pointer;
		transition: background 0.2s;
	}
	
	.access-code:hover {
		background: var(--accent-soft);
	}
	
	.tip {
		font-size: 0.6rem;
		color: var(--text-faint);
		opacity: 0.5;
	}

	.no-results {
		text-align: center;
		padding: 40px;
		color: var(--text-muted);
		border: 1px dashed var(--border);
		border-radius: 8px;
	}
</style>

<script>
	document.addEventListener('DOMContentLoaded', () => {
		const searchInput = document.getElementById('downloadSearchInput');
		// @ts-ignore
		const cards = document.querySelectorAll('.cartridge-card');
		const noResults = document.getElementById('downloadNoResults');

		searchInput?.addEventListener('input', (e) => {
			// @ts-ignore
			const query = e.target.value.toLowerCase().trim();
			let visibleCount = 0;

			cards.forEach((card) => {
				// @ts-ignore
				const searchData = card.dataset.search;
				if (!query || searchData.includes(query)) {
					// @ts-ignore
					card.style.display = 'flex';
					visibleCount++;
				} else {
					// @ts-ignore
					card.style.display = 'none';
				}
			});

			if (noResults) {
				noResults.style.display = visibleCount === 0 ? 'block' : 'none';
			}
		});
	});
</script>
</BaseLayout>
