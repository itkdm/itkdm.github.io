---
import { getCollection } from 'astro:content';
import BaseLayout from '../../../layouts/BaseLayout.astro';
import DocsListRedesign from '../../../components/DocsListRedesign.astro';
import type { Lang } from '../../../i18n/config';
import { SUPPORTED_LANGS } from '../../../i18n/config';

export function getStaticPaths() {
	return SUPPORTED_LANGS.map((lang) => ({ params: { lang } }));
}

const { lang } = Astro.params as { lang: Lang };

const pageTitle = lang === 'zh' ? '文档中心' : 'Docs';
const pageDesc =
	lang === 'zh'
		? '按分类浏览全部文档，左侧筛选分类，中间查看该分类下的所有文章。'
		: 'Browse all docs by category. Filter categories on the left and explore every article in each section.';
---

<BaseLayout
	lang={lang}
	title={pageTitle}
	description={pageDesc}
	currentPath={`/${lang}/docs/`}
>
    <DocsListRedesign lang={lang} />
</BaseLayout>
