---
import { getCollection } from 'astro:content';
import BaseLayout from '../../../layouts/BaseLayout.astro';
import DocsListRedesign from '../../../components/DocsListRedesign.astro';
import type { Lang } from '../../../i18n/config';
import { SUPPORTED_LANGS } from '../../../i18n/config';

export function getStaticPaths() {
	return SUPPORTED_LANGS.map((lang) => ({ params: { lang } }));
}

const { lang } = Astro.params as { lang: Lang };
const hasDocs = (await getCollection('docs', (doc) => doc.data.lang === lang)).length > 0;

const pageTitle = lang === 'zh' ? '文档中心' : 'Docs';
const pageDesc =
	lang === 'zh'
		? '个人学习知识库，记录技术学习笔记、教程和实践理解，后续会逐步补充完善。'
		: 'A personal learning knowledge base for technical notes, tutorials, and practical understanding, gradually expanded over time.';
---

<BaseLayout
	lang={lang}
	title={pageTitle}
	description={pageDesc}
	currentPath={`/${lang}/docs/`}
	robots={hasDocs ? 'index, follow' : 'noindex, follow'}
>
	<DocsListRedesign lang={lang} />
</BaseLayout>
