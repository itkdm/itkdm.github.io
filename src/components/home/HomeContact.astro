---
import { CONTACT_EMAIL_HREF, CONTACT_GITHUB_URL, homeContactChannels } from '../../data/home-contact';

const { lang } = Astro.props as { lang: 'zh' | 'en' };
const isZh = lang === 'zh';
const collaborationRows = [
	{ order: '01', title: 'AI & ENGINEERING', copy: isZh ? 'AI 全栈、Agent、RAG、工程化实践、产品落地' : 'AI Full-Stack · Agents · RAG · Engineering · Products', href: CONTACT_EMAIL_HREF },
	{ order: '02', title: 'OPEN SOURCE', copy: isZh ? '开源项目、技术协作、社区共建、技术交流' : 'Open-source projects · Collaboration · Community · Exchange', href: CONTACT_GITHUB_URL },
	{ order: '03', title: 'TRAINING & CONTENT', copy: isZh ? '企业技术培训、技术分享、内容合作' : 'Technical training · Talks · Content collaboration', href: CONTACT_EMAIL_HREF },
];
---

<section id="contact" class="home-contact-closing" data-contact-closing aria-labelledby="contact-title">
	<div class="home-contact-frame">
		<header class="home-contact-header" data-contact-reveal>
			<p class="home-contact-label"><span aria-hidden="true">●</span>06 · CONTACT</p>
			<h2 id="contact-title">
				{isZh ? <><span>让想法落地，</span><span>让合作发生。</span></> : <><span>Turn ideas into things</span><span>that work.</span></>}
			</h2>
			<p class="home-contact-intro">{isZh ? 'AI、开源、技术内容，以及那些值得一起做的事情。' : 'AI, open source, technical content, and ideas worth building together.'}</p>
		</header>

		<div class="home-contact-channel-mark" data-contact-reveal><span>OPEN CHANNEL</span><i aria-hidden="true"></i></div>

		<div class="home-contact-directions" aria-label={isZh ? '合作方向' : 'Collaboration areas'}>
			{collaborationRows.map((row, index) => (
				<a class="home-contact-direction" data-contact-reveal style={`--contact-delay: ${index * 90 + 180}ms`} href={row.href} target={row.href.startsWith('https://') ? '_blank' : undefined} rel={row.href.startsWith('https://') ? 'noopener noreferrer' : undefined}>
					<div class="home-contact-direction-title"><span>{row.order}</span><b aria-hidden="true">•</b><strong>{row.title}</strong></div>
					<p>{row.copy}</p>
					<span class="home-contact-arrow" aria-hidden="true">→</span>
				</a>
			))}
		</div>

		<div class="home-contact-channels" aria-label={isZh ? '联系渠道' : 'Contact channels'} data-contact-reveal>
			{homeContactChannels.filter((channel) => channel.enabled).map((channel) => (
				<div class="home-contact-channel">
					<p><span aria-hidden="true">•</span>{channel.label}</p>
					{channel.type === 'qr' ? (
						<button class="home-contact-channel-link" type="button" aria-haspopup="dialog" aria-controls="wechat-dialog" aria-expanded="false" data-wechat-trigger>
							{channel.display}<span aria-hidden="true">↗</span>
						</button>
					) : (
						<a class="home-contact-channel-link" href={channel.href} target={channel.key === 'github' ? '_blank' : undefined} rel={channel.key === 'github' ? 'noopener noreferrer' : undefined} aria-label={`${channel.label} ${channel.display}`}>
							{channel.display}<span aria-hidden="true">↗</span>
						</a>
					)}
				</div>
			))}
		</div>
	</div>

	<dialog class="home-contact-dialog" id="wechat-dialog" data-wechat-dialog aria-labelledby="wechat-dialog-title">
		<div class="home-contact-dialog-inner">
			<button class="home-contact-dialog-close" type="button" aria-label={isZh ? '关闭微信二维码' : 'Close WeChat QR'} data-wechat-close>×</button>
			<p class="home-contact-dialog-label">WECHAT</p>
			<h3 id="wechat-dialog-title">{isZh ? '扫一扫添加微信' : 'Scan to connect'}</h3>
			<img src={homeContactChannels.find((channel) => channel.key === 'wechat')?.qrImage} alt={isZh ? '微信二维码' : 'WeChat QR code'} />
			<p>{isZh ? '合作沟通请简单备注来意' : 'Please include a short note about your inquiry.'}</p>
		</div>
	</dialog>
</section>

<style>
	.home-contact-closing { position: relative; min-height: 100svh; overflow: hidden; background: var(--closing-background); color: var(--closing-text); }
	.home-contact-frame { position: relative; width: min(100% - clamp(40px, 7vw, 118px), 1600px); min-height: 100svh; margin: 0 auto; padding: clamp(58px, 7vw, 108px) 0 clamp(72px, 8vw, 112px); }
	.home-contact-header { width: min(760px, 75%); }
	.home-contact-label, .home-contact-channel-mark, .home-contact-direction-title span, .home-contact-channels p { font: 11px var(--mono); letter-spacing: .2em; }
	.home-contact-label { display: flex; gap: 12px; align-items: center; margin: 0 0 clamp(48px, 7vw, 88px); color: var(--closing-text); }
	.home-contact-label span, .home-contact-direction-title span, .home-contact-channels p span { color: var(--closing-accent); }
	.home-contact-header h2 { margin: 0; font: 650 clamp(56px, 7.2vw, 116px)/1.06 var(--display); letter-spacing: -.07em; }
	.home-contact-header h2 span { display: block; }
	.home-contact-intro { display: flex; align-items: center; gap: 18px; margin: 30px 0 0; color: var(--closing-text-secondary); font: 16px/1.7 var(--display); }
	.home-contact-intro::before { content: ''; width: 38px; height: 2px; flex: 0 0 auto; background: var(--closing-accent); }
	.home-contact-channel-mark { position: absolute; top: clamp(62px, 7vw, 108px); right: 0; width: 220px; color: var(--closing-text); }
	.home-contact-channel-mark i { display: block; position: relative; height: 1px; margin-top: 13px; background: var(--closing-divider); }
	.home-contact-channel-mark i::after { content: ''; position: absolute; right: 0; top: 50%; width: 8px; height: 8px; border-radius: 50%; background: var(--closing-accent); transform: translateY(-50%); }
	.home-contact-directions { margin-top: clamp(54px, 8vw, 100px); }
	.home-contact-direction { position: relative; display: grid; grid-template-columns: minmax(300px, 1.05fr) minmax(300px, 1fr) 48px; align-items: center; min-height: 80px; border-bottom: 1px solid var(--closing-divider); transition: color .25s ease; }
	.home-contact-direction::after { content: ''; position: absolute; right: 0; bottom: -1px; left: 0; height: 1px; background: var(--closing-accent); transform: scaleX(0); transform-origin: left; transition: transform .45s ease; }
	.home-contact-direction:hover::after, .home-contact-direction:focus-within::after { transform: scaleX(1); }
	.home-contact-direction-title { display: flex; gap: 16px; align-items: center; }
	.home-contact-direction-title b { color: var(--closing-accent); font-size: 17px; font-weight: 400; }
	.home-contact-direction-title strong { font: 16px var(--mono); letter-spacing: .2em; }
	.home-contact-direction p { margin: 0; color: var(--closing-text-secondary); font: 15px/1.5 var(--display); transition: color .25s ease; }
	.home-contact-direction:hover p { color: var(--closing-text); }
	.home-contact-arrow { justify-self: end; color: var(--closing-accent); font: 28px var(--sans); transition: transform .25s ease, color .25s ease; }
	.home-contact-direction:hover .home-contact-arrow { transform: translateX(4px); color: var(--closing-text); }
	.home-contact-channels { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: clamp(32px, 5vw, 80px); margin-top: clamp(58px, 7vw, 96px); }
	.home-contact-channel { min-width: 0; width: 100%; }
	.home-contact-channels p { margin: 0 0 18px; color: var(--closing-text-secondary); }
	.home-contact-channels p span { margin-right: 12px; }
	.home-contact-channel-link { display: inline-flex; gap: 12px; align-items: center; padding: 0 0 8px; border: 0; border-bottom: 1px solid var(--closing-divider); background: transparent; color: var(--closing-text); font: clamp(24px, 2.4vw, 38px) var(--display); text-decoration: none; cursor: pointer; }
	.home-contact-channel-link span { color: var(--closing-accent); font-family: var(--sans); transition: transform .2s ease; }
	.home-contact-channel-link:hover { border-color: var(--closing-accent); color: var(--closing-accent); }
	.home-contact-channel-link:hover span { transform: translate(3px, -3px); }
	.home-contact-dialog { width: min(330px, calc(100% - 32px)); padding: 0; border: 1px solid var(--closing-divider); background: var(--closing-surface); color: var(--closing-text); box-shadow: var(--shadow-2); }
	.home-contact-dialog::backdrop { background: color-mix(in srgb, var(--text-primary) 36%, transparent); }
	.home-contact-dialog-inner { position: relative; padding: 28px; text-align: center; }
	.home-contact-dialog-close { position: absolute; top: 8px; right: 12px; border: 0; background: transparent; color: var(--closing-text-muted); font-size: 24px; cursor: pointer; }
	.home-contact-dialog-label { margin: 0 0 8px; color: var(--closing-accent); font: 10px var(--mono); letter-spacing: .2em; }
	.home-contact-dialog h3 { margin: 0 0 18px; font: 650 24px var(--display); }
	.home-contact-dialog img { display: block; width: 220px; height: 220px; margin: 0 auto 16px; object-fit: contain; background: var(--surface); }
	.home-contact-dialog-inner > p:last-child { margin: 0; color: var(--closing-text-secondary); font: 12px/1.6 var(--display); }
	.home-contact-dialog-close:focus-visible, .home-contact-direction:focus-visible, .home-contact-channel-link:focus-visible { outline: 2px solid var(--closing-accent); outline-offset: 4px; }
	.home-contact-closing [data-contact-reveal] { opacity: 0; transform: translateY(16px); }
	.home-contact-closing.is-visible [data-contact-reveal] { opacity: 1; transform: translateY(0); transition: opacity .7s ease, transform .8s cubic-bezier(.2,.8,.2,1); }
	.home-contact-closing.is-visible .home-contact-direction { transition-delay: var(--contact-delay); }
	@media (max-width: 760px) {
		.home-contact-frame { width: calc(100% - 32px); padding: 54px 0 72px; }
		.home-contact-header { width: 100%; }
		.home-contact-label { margin-bottom: 52px; }
		.home-contact-header h2 { font-size: clamp(45px, 12.5vw, 68px); line-height: 1.08; }
		.home-contact-intro { align-items: flex-start; gap: 12px; margin-top: 24px; font-size: 14px; }
		.home-contact-intro::before { width: 26px; margin-top: 10px; }
		.home-contact-channel-mark { top: 54px; width: 128px; font-size: 8px; letter-spacing: .12em; }
		.home-contact-directions { margin-top: 58px; }
		.home-contact-direction { grid-template-columns: 1fr 28px; gap: 10px; min-height: 110px; padding: 18px 0; }
		.home-contact-direction-title { gap: 9px; flex-wrap: wrap; }
		.home-contact-direction-title strong { width: 100%; font-size: 13px; letter-spacing: .13em; }
		.home-contact-direction p { grid-column: 1; font-size: 13px; }
		.home-contact-arrow { grid-column: 2; grid-row: 1 / span 2; }
		.home-contact-channels { display: block; margin-top: 54px; }
		.home-contact-channel { min-width: 0; margin-bottom: 30px; }
		.home-contact-channel-link { max-width: 100%; font-size: clamp(22px, 7vw, 30px); white-space: nowrap; }
	}
	@media (prefers-reduced-motion: reduce) {
		.home-contact-closing [data-contact-reveal] { opacity: 1; transform: none; transition: none; }
		.home-contact-direction::after { transition: none; }
		.home-contact-direction, .home-contact-channel-link span { transition: none; }
	}
	@media (min-width: 761px) and (max-width: 1100px) {
		.home-contact-channels { grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 32px; }
		.home-contact-channel:last-child { grid-column: 1 / -1; }
	}
</style>

<script>
	const contactSection = document.querySelector<HTMLElement>('[data-contact-closing]');
	if (contactSection) {
		const reveal = () => contactSection.classList.add('is-visible');
		if (window.matchMedia('(prefers-reduced-motion: reduce)').matches || !('IntersectionObserver' in window)) reveal();
		else {
			const observer = new IntersectionObserver(([entry]) => {
				if (entry.isIntersecting) {
					reveal();
					observer.disconnect();
				}
			}, { threshold: 0.12 });
			observer.observe(contactSection);
		}
	}

	const wechatDialog = document.querySelector<HTMLDialogElement>('[data-wechat-dialog]');
	const wechatTrigger = document.querySelector<HTMLButtonElement>('[data-wechat-trigger]');
	const wechatClose = document.querySelector<HTMLButtonElement>('[data-wechat-close]');
	const closeWechat = () => {
		wechatDialog?.close();
		wechatTrigger?.setAttribute('aria-expanded', 'false');
	};
	wechatTrigger?.addEventListener('click', () => {
		wechatDialog?.showModal();
		wechatTrigger.setAttribute('aria-expanded', 'true');
		wechatClose?.focus();
	});
	wechatClose?.addEventListener('click', closeWechat);
	wechatDialog?.addEventListener('click', (event) => {
		if (event.target === wechatDialog) closeWechat();
	});
	wechatDialog?.addEventListener('cancel', closeWechat);
</script>
