---
import DocsFileTree from './DocsFileTree.astro';

interface Props {
	lang: 'zh' | 'en';
}

const { lang } = Astro.props;
---

<section class="docs-browser">
	<aside class="docs-browser-tree">
		<DocsFileTree lang={lang} />
	</aside>

	<main class="docs-browser-main" aria-label={lang === 'zh' ? '文档首页空白区域' : 'Empty docs home'}></main>
</section>

<style>
	.docs-browser {
		display: grid;
		grid-template-columns: minmax(280px, 340px) minmax(0, 1fr);
		gap: 22px;
		max-width: 1380px;
		margin: 0 auto;
		padding: 24px 16px 64px;
		align-items: start;
	}

	.docs-browser-tree {
		position: sticky;
		top: 86px;
		min-width: 0;
	}

	.docs-browser-main {
		min-width: 0;
		min-height: 420px;
	}

	@media (max-width: 900px) {
		.docs-browser {
			grid-template-columns: 1fr;
			padding: 14px 12px 48px;
		}

		.docs-browser-tree {
			position: relative;
			top: 0;
		}
	}
</style>
