---
import type { CollectionEntry } from 'astro:content';
import yellowTrackUrl from '../Yellow - Coldplay.mp3?url';

type StatItem = {
	label: string;
	value: string;
	hint: string;
};

type DocCard = {
	section: string;
	description: string;
	count: number;
};

type Action = {
	href: string;
	label: string;
	style?: 'primary' | 'ghost';
};

type Labels = {
	heroKicker: string;
	heroTitle: string;
	heroLead: string;
	heroNote: string;
	primaryAction: Action;
	secondaryAction: Action;
	stats: StatItem[];
	spotlightLabel: string;
	spotlightTitle: string;
	spotlightBody: string;
	spotlightLink: string;
	latestSection: string;
	latestMore: string;
	latestFeatured: string;
	latestContinue: string;
	latestRead: string;
	latestFallback: string;
	latestArticleType: string;
	latestTagFallback: string;
	docsSection: string;
	docsMore: string;
	docsSummaryTitle: string;
	docsSummaryBody: string;
	docsSummaryLink: string;
	docsCountSuffix: string;
	docsArrow: string;
	projectsSection: string;
	projectsMore: string;
	projectsFeatured: string;
	projectsOpen: string;
	projectsDemo: string;
	projectsFallback: string;
	toolsSection: string;
	toolsMore: string;
	toolsSummaryTitle: string;
	toolsSummaryBody: string;
	toolsSummaryLink: string;
	toolsFallback: string;
};

const {
	lang,
	labels,
	latestPost,
	secondaryPosts,
	docsCards,
	featuredProjects,
	featuredTools,
} = Astro.props as {
	lang: 'zh' | 'en';
	labels: Labels;
	latestPost?: CollectionEntry<'blog'>;
	secondaryPosts: CollectionEntry<'blog'>[];
	docsCards: DocCard[];
	featuredProjects: CollectionEntry<'projects'>[];
	featuredTools: CollectionEntry<'tools'>[];
};

const dateLocale = lang === 'zh' ? 'zh-CN' : 'en-US';
const formatDate = (date: Date) =>
	new Intl.DateTimeFormat(dateLocale, {
		year: 'numeric',
		month: 'short',
		day: 'numeric',
	}).format(date);
---

<style is:global>
	:root {
		--font-mono: 'JetBrains Mono', 'Fira Code', ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, monospace;
	}

	/* 
	   HOMEPAGE THEME LOGIC
	   We use a body class .home-redesign-active to scope these overrides 
	   so they only apply when this component is mounted.
	*/

	/* --- Light Mode (Default) --- */
	body.home-redesign-active {
		/* Inherit base colors from theme.css for consistency */
		--r-bg-main: var(--bg);
		
		/* Removed pattern to match documentation pages exactly */
		--r-bg-pattern: none; 
		--r-bg-size: auto;
		
		/* Card colors based on theme vars but slightly elevated */
		--r-card-bg: var(--bg-elev); 
		--r-card-hover: var(--bg);
		
		--r-border: var(--border);
		--r-border-hover: var(--border-strong);
		
		--r-text-primary: var(--text);
		--r-text-secondary: var(--text-muted);
		
		/* Keep accent colors distinct or derive from theme */
		--r-accent: var(--primary); 
		
		--r-shadow: var(--shadow-1);
		--r-glass: blur(10px);
		
		background-color: var(--r-bg-main) !important;
		background-image: none !important;
		color: var(--r-text-primary) !important;
	}

	/* --- Dark Mode --- */
	html[data-theme='dark'] body.home-redesign-active {
		--r-bg-main: var(--bg);
		/* Removed aurora effect to ensure background color matches docs */
		--r-bg-pattern: none;
		--r-bg-size: auto;
		
		--r-card-bg: var(--bg-elev);
		--r-card-hover: var(--bg-soft);
		
		--r-border: var(--border);
		--r-border-hover: var(--border-strong);
		
		--r-text-primary: var(--text);
		--r-text-secondary: var(--text-muted);
		
		--r-accent: var(--accent);
		--r-shadow: var(--shadow-2);
	}
	
	/* --- Paper Mode (Reuse Light Logic basically) --- */
	html[data-theme='paper'] body.home-redesign-active {
		--r-bg-pattern: none; /* Paper usually cleaner */
	}

	/* Header/Footer/Menu Overrides */
	body.home-redesign-active header.topbar,
	body.home-redesign-active footer {
		background-color: transparent !important;
		border-color: var(--r-border) !important;
		backdrop-filter: var(--r-glass);
	}
	body.home-redesign-active header.topbar a,
	body.home-redesign-active footer {
		color: var(--r-text-secondary) !important;
	}
	body.home-redesign-active header.topbar a:hover {
		color: var(--r-text-primary) !important;
	}

	/* Mobile Menu */
	body.home-redesign-active .mobile-menu {
		background: var(--r-card-bg) !important;
		border-left: 1px solid var(--r-border);
	}
	body.home-redesign-active .mobile-menu-item {
		color: var(--r-text-secondary) !important;
	}
	body.home-redesign-active .mobile-menu-item:hover {
		background: var(--r-border) !important; 
		color: var(--r-text-primary) !important;
	}

	/* component styles using the variables */
	.bento-card {
		background: var(--r-card-bg);
		border: 1px solid var(--r-border);
		border-radius: 12px;
		padding: 1.5rem;
		position: relative;
		overflow: hidden;
		display: flex;
		flex-direction: column;
		text-decoration: none;
		box-shadow: var(--r-shadow);
	}

	.bento-card:hover {
		border-color: var(--r-border-hover);
		background: var(--r-card-hover);
	}

	/* Typography */
	h1, h2, h3, .mono-font, .hero-title, .post-title, .project-name, .tool-name {
		font-family: var(--font-mono);
		letter-spacing: -0.03em;
		color: var(--r-text-primary) !important;
	}
	p, .post-summary, .stat-label, .doc-count, .doc-title {
		color: var(--r-text-secondary);
	}
</style>

<script>
	// Add class to body when component mounts
	document.body.classList.add('home-redesign-active');
	
	// Cleanup when navigating away
	document.addEventListener('astro:before-swap', () => {
		document.body.classList.remove('home-redesign-active');
	});

	const setupHeroPlayer = () => {
		const player = document.querySelector('[data-hero-player]');
		if (!player) return;
		if (player instanceof HTMLElement && player.dataset.playerBound === 'true') return;

		const audio = player.querySelector('audio');
		const playButtons = player.querySelectorAll('[data-player-toggle]');
		const muteButton = player.querySelector('[data-player-mute]');
		const volumeSlider = player.querySelector('[data-player-volume]');
		const statusLabel = player.querySelector('[data-player-status]');
		const volumeValue = player.querySelector('[data-player-volume-value]');

		if (!(audio instanceof HTMLAudioElement)) return;
		if (playButtons.length === 0) return;
		if (!(muteButton instanceof HTMLButtonElement)) return;
		if (!(volumeSlider instanceof HTMLInputElement)) return;
		if (!(statusLabel instanceof HTMLElement)) return;
		if (!(volumeValue instanceof HTMLElement)) return;

		const syncUi = () => {
			const isPlaying = !audio.paused;
			playButtons.forEach(btn => {
				if (btn instanceof HTMLButtonElement) {
					btn.classList.toggle('playing', isPlaying);
				}
			});
			muteButton.classList.toggle('muted', audio.muted || audio.volume === 0);
			statusLabel.textContent = isPlaying ? 'Now playing' : 'Ready to play';
			volumeSlider.value = String(Math.round(audio.volume * 100));
			volumeValue.textContent = `${Math.round(audio.volume * 100)}%`;
		};

		const handlePlayClick = async () => {
			if (audio.paused) {
				try {
					await audio.play();
				} catch (error) {
					statusLabel.textContent = 'Playback blocked';
				}
			} else {
				audio.pause();
			}
			syncUi();
		};

		playButtons.forEach(btn => {
			if (btn instanceof HTMLButtonElement) {
				btn.addEventListener('click', handlePlayClick);
			}
		});

		muteButton.addEventListener('click', () => {
			audio.muted = !audio.muted;
			syncUi();
		});

		volumeSlider.addEventListener('input', () => {
			const nextVolume = Number(volumeSlider.value) / 100;
			audio.volume = nextVolume;
			audio.muted = nextVolume === 0;
			syncUi();
		});

		audio.addEventListener('play', syncUi);
		audio.addEventListener('pause', syncUi);
		audio.addEventListener('volumechange', syncUi);
		audio.addEventListener('ended', syncUi);

		audio.volume = 0.45;
		if (player instanceof HTMLElement) {
			player.dataset.playerBound = 'true';
		}
		syncUi();
	};

	if (document.readyState === 'loading') {
		document.addEventListener('DOMContentLoaded', setupHeroPlayer, { once: true });
	} else {
		setupHeroPlayer();
	}

	document.addEventListener('astro:page-load', setupHeroPlayer);
</script>

<div class="home-redesign-v2">
	
	{/* Hero Section */}
	<section class="hero-section">
		<div class="hero-content">
			<div class="glitch-wrapper">
				<h1 class="hero-title glitch" data-text={labels.heroTitle}>
					{labels.heroTitle}
				</h1>
			</div>
			
			<div class="typewriter-container">
				<p class="hero-lead typing-effect">{labels.heroLead}</p>
			</div>
			
			<div class="hero-actions">
				<a href={labels.primaryAction.href} class="btn-tech primary">
					<span class="btn-bracket">[</span> 
					{labels.primaryAction.label} 
					<span class="btn-bracket">]</span>
				</a>
				<a href={labels.secondaryAction.href} class="btn-tech ghost">
					{labels.secondaryAction.label}
				</a>
			</div>

			<!-- Floating Music Player -->
			<div class="floating-player" data-hero-player>
				<button type="button" class="player-toggle-btn" data-player-toggle aria-label="Toggle music player">
					<svg class="player-icon play-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
						<circle cx="12" cy="12" r="10"></circle>
						<polygon points="8 5 15 12 8 19 8 5"></polygon>
						<polygon points="16 5 23 12 16 19 16 5"></polygon>
					</svg>
					<svg class="player-icon pause-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
						<circle cx="12" cy="12" r="10"></circle>
						<rect x="8" y="5" width="3" height="14" rx="1"></rect>
						<rect x="13" y="5" width="3" height="14" rx="1"></rect>
					</svg>
					<div class="player-pulse" aria-hidden="true"></div>
					<div class="player-glow" aria-hidden="true"></div>
				</button>
				<div class="player-panel">
					<div class="player-info">
						<p class="player-kicker">Now Spinning</p>
						<h3>Yellow</h3>
						<p class="player-artist">Coldplay</p>
					</div>
					<div class="player-controls">
						<button type="button" class="player-btn play-btn" data-player-toggle>
							<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
								<path d="M6 4h4v16H6zM14 4h4v16h-4z"></path>
							</svg>
						</button>
						<button type="button" class="player-btn mute-btn" data-player-mute>
							<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
								<polygon points="11 5 6 9 2 9 2 15 6 15 11 19 11 5"></polygon>
								<path d="M15.54 8.46a5 5 0 0 1 0 7.07"></path>
								<path d="M19.07 4.93a10 10 0 0 1 0 14.14"></path>
							</svg>
						</button>
					</div>
					<label class="player-volume-control">
						<input type="range" min="0" max="100" value="45" data-player-volume />
					</label>
					<div class="player-status-bar">
						<span data-player-status>Ready to play</span>
						<span data-player-volume-value>45%</span>
					</div>
				</div>
				<audio preload="metadata" src={yellowTrackUrl}>
			</div>
		</div>
	</section>

	{/* Main Grid Layout */}
	<div class="bento-grid">
		
		{/* Top Row: Latest Post (Large) */}
		{latestPost && (
			<a href={`/${lang}/blog/${latestPost.data.slug ?? latestPost.slug.split('/').pop() ?? latestPost.slug}/`} class="bento-card featured-post-card span-8">
				<div class="card-badge">Latest.Log</div>
				<div class="card-content">
					<h2 class="post-title">{latestPost.data.title}</h2>
					<p class="post-summary">{latestPost.data.summary}</p>
					<div class="meta-row">
						<span class="meta-tag">#{latestPost.data.tags[0]}</span>
						<span class="meta-date">{formatDate(latestPost.data.date)}</span>
					</div>
				</div>
				<div class="card-bg-gradient"></div>
			</a>
		)}

		{/* Top Row: Secondary Stats (small) */}
		<div class="bento-card stats-card span-4">
			<div class="card-header">
				<h3>System.Status</h3>
			</div>
			<div class="stats-list">
				{labels.stats.map(stat => (
					<div class="stat-row">
						<span class="stat-label">:: {stat.label}</span>
						<div class="stat-line"></div>
						<span class="stat-val">{stat.value}</span>
					</div>
				))}
			</div>
		</div>

		{/* Middle Row: Docs (Medium) */}
		<div class="bento-card docs-card span-6">
			<div class="card-header-row">
				<h3>Documentation.Index</h3>
				<a href={`/${lang}/docs/`} class="link-arrow">ALL &rarr;</a>
			</div>
			<div class="docs-micro-grid">
				{docsCards.map(doc => (
					<a href={`/${lang}/docs/#${encodeURIComponent(doc.section)}`} class="doc-micro-item">
						<div class="doc-icon-box">
							<svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"></path><polyline points="14 2 14 8 20 8"></polyline><line x1="16" y1="13" x2="8" y2="13"></line><line x1="16" y1="17" x2="8" y2="17"></line><polyline points="10 9 9 9 8 9"></polyline></svg>
						</div>
						<div class="doc-text">
							<span class="doc-title">{doc.section}</span>
							<span class="doc-count">{doc.count} modules</span>
						</div>
					</a>
				))}
			</div>
		</div>

		{/* Middle Row: Featured Projects (Medium) */}
		<div class="bento-card projects-card span-6">
			<div class="card-header-row">
				<h3>Projects.Deployed</h3>
				<a href={`/${lang}/projects/`} class="link-arrow">ALL &rarr;</a>
			</div>
			<div class="projects-list">
				{featuredProjects.map(project => (
					<a href={`/${lang}/projects/${project.data.slug ?? project.slug.split('/').pop() ?? project.slug}/`} class="project-item-row">
						<span class="status-dot"></span>
						<span class="project-name">{project.data.title}</span>
						<span class="project-desc-short">{project.data.summary.slice(0, 30)}...</span>
					</a>
				))}
			</div>
		</div>

		{/* Bottom Row: Tools (Strip) */}
		<div class="bento-card tools-card span-12">
			<div class="card-header-row">
				<h3>Tools.Utility</h3>
				<a href={`/${lang}/tools/`} class="link-arrow">VIEW ALL</a>
			</div>
			
			<div class="tools-marquee">
				<div class="tools-track">
					{/* Original Set */}
					{featuredTools.map(tool => (
						<a href={tool.data.homepage} target="_blank" class="tool-chip">
							<span class="tool-icon">{tool.data.icon ?? '#'}</span>
							<span class="tool-name">{tool.data.name}</span>
						</a>
					))}
					{/* Duplicate Set for Seamless Loop */}
					{featuredTools.map(tool => (
						<a href={tool.data.homepage} target="_blank" class="tool-chip">
							<span class="tool-icon">{tool.data.icon ?? '#'}</span>
							<span class="tool-name">{tool.data.name}</span>
						</a>
					))}
				</div>
			</div>
		</div>

	</div>
</div>

<style>
	/* Layout Grid */
	.bento-grid {
		display: grid;
		grid-template-columns: repeat(12, 1fr);
		gap: 1.5rem;
		padding: 2rem 0;
		max-width: 1400px; /* Wider for dashboard feel */
		margin: 0 auto;
	}
	
	.span-12 { grid-column: span 12; }
	.span-8 { grid-column: span 12; } /* Mobile first: full width */
	.span-6 { grid-column: span 12; }
	.span-4 { grid-column: span 12; }

	@media (min-width: 768px) {
		.span-8 { grid-column: span 8; }
		.span-6 { grid-column: span 6; }
		.span-4 { grid-column: span 4; }
	}

	/* Hero Styles */
	.hero-section {
		text-align: center;
		padding: 6rem 1rem 4rem;
		position: relative;
		overflow: hidden;
	}
	
	.hero-title {
		font-size: 2.5rem;
		line-height: 1.2;
		font-weight: 700;
		/* color removed - handled by global variable */
		margin-bottom: 1.5rem;
		position: relative;
		display: inline-block;
	}

	@media(min-width: 768px) {
		.hero-title { font-size: 4rem; }
	}

	.hero-lead {
		font-size: 1.1rem;
		/* color removed */
		max-width: 700px;
		margin: 0 auto 3rem;
		line-height: 1.6;
		font-family: var(--font-mono);
	}

	.hero-actions {
		display: flex;
		justify-content: center;
		gap: 1.5rem;
		flex-wrap: wrap;
		margin-bottom: 1.75rem;
	}

	/* Floating Music Player */
	.floating-player {
		position: fixed;
		top: 80px;
		right: 20px;
		z-index: 100;
		display: flex;
		flex-direction: column;
		align-items: flex-end;
		gap: 10px;
	}

	.player-toggle-btn {
		width: 52px;
		height: 52px;
		border-radius: 50%;
		background: rgba(255, 255, 255, 0.95);
		border: 1px solid var(--r-border);
		color: var(--r-text-primary);
		display: flex;
		align-items: center;
		justify-content: center;
		cursor: pointer;
		transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
		position: relative;
		box-shadow: 0 2px 12px rgba(0, 0, 0, 0.08);
	}

	.player-toggle-btn:hover {
		background: var(--r-accent);
		color: #ffffff;
		border-color: var(--r-accent);
		box-shadow: 0 4px 20px rgba(59, 130, 246, 0.35);
	}

	.player-icon {
		width: 22px;
		height: 22px;
		transition: opacity 0.3s ease;
	}

	.player-icon.pause-icon {
		display: none;
	}

	.player-toggle-btn.playing .play-icon {
		display: none;
	}

	.player-toggle-btn.playing .pause-icon {
		display: block;
	}

	.player-pulse {
		position: absolute;
		width: 100%;
		height: 100%;
		border-radius: 50%;
		background: var(--r-accent);
		opacity: 0;
		animation: player-pulse 2s ease-out infinite;
	}

	.player-toggle-btn.playing .player-pulse {
		animation: player-pulse 1.5s ease-out infinite;
	}

	@keyframes player-pulse {
		0% {
			transform: scale(1);
			opacity: 0.4;
		}
		100% {
			transform: scale(1.8);
			opacity: 0;
		}
	}

	.player-glow {
		position: absolute;
		width: 100%;
		height: 100%;
		border-radius: 50%;
		background: radial-gradient(circle, rgba(59, 130, 246, 0.3) 0%, transparent 70%);
		opacity: 0;
		transition: opacity 0.3s ease;
	}

	.player-toggle-btn:hover .player-glow {
		opacity: 1;
	}

	.player-panel {
		position: absolute;
		top: 60px;
		right: 0;
		width: 280px;
		background: var(--r-card-bg);
		border: 1px solid var(--r-border);
		border-radius: 12px;
		padding: 16px;
		opacity: 0;
		visibility: hidden;
		transform: translateY(-10px);
		transition: all 0.3s ease;
		box-shadow: var(--r-shadow);
	}

	.floating-player:hover .player-panel,
	.player-panel:hover {
		opacity: 1;
		visibility: visible;
		transform: translateY(0);
	}

	.player-info {
		display: flex;
		flex-direction: column;
		gap: 4px;
		margin-bottom: 16px;
	}

	.player-kicker {
		margin: 0;
		font-family: var(--font-mono);
		font-size: 0.7rem;
		letter-spacing: 0.1em;
		text-transform: uppercase;
		color: var(--r-accent);
	}

	.player-info h3 {
		margin: 0;
		font-size: 1.2rem;
	}

	.player-artist {
		margin: 0;
		font-size: 0.85rem;
		color: var(--r-text-secondary);
	}

	.player-controls {
		display: flex;
		gap: 12px;
		margin-bottom: 12px;
	}

	.player-btn {
		width: 40px;
		height: 40px;
		border-radius: 8px;
		border: 1px solid var(--r-border);
		background: rgba(255, 255, 255, 0.05);
		color: var(--r-text-primary);
		display: flex;
		align-items: center;
		justify-content: center;
		cursor: pointer;
		transition: all 0.2s ease;
	}

	.player-btn svg {
		width: 16px;
		height: 16px;
	}

	.player-btn:hover {
		border-color: var(--r-accent);
		background: rgba(6, 182, 212, 0.1);
	}

	.play-btn.playing svg path:first-child,
	.play-btn.playing svg path:last-child {
		d: path('M12 4v16');
	}

	.mute-btn.muted svg path:nth-child(2),
	.mute-btn.muted svg path:nth-child(3) {
		display: none;
	}

	.mute-btn.muted svg::after {
		content: '';
		position: absolute;
		width: 16px;
		height: 16px;
