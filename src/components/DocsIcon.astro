---
interface Props {
	icon?: string;
}

const { icon = '' } = Astro.props;

const normalizedIcon = icon.trim();

const svgIcons: Record<string, string> = {
	file: `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round"><path d="M14 3H7a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h10a2 2 0 0 0 2-2V8l-5-5Z"/><path d="M14 3v5h5"/><path d="M9 13h6"/><path d="M9 17h4"/></svg>`,
	brain: `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round"><path d="M9.5 3.5a3.5 3.5 0 0 0-3.34 4.54A4 4 0 0 0 4 11.5 4 4 0 0 0 7.5 15.45V16a3 3 0 0 0 3 3"/><path d="M14.5 3.5a3.5 3.5 0 0 1 3.34 4.54A4 4 0 0 1 20 11.5a4 4 0 0 1-3.5 3.95V16a3 3 0 0 1-3 3"/><path d="M12 6v12"/><path d="M9 8.5h3"/><path d="M12 15.5h3"/><path d="M8 12h4"/><path d="M12 12h4"/></svg>`,
