---
import BaseLayout from './BaseLayout.astro';
import type { Lang } from '../i18n/config';
import type { CollectionEntry } from 'astro:content';
import DocsFileTree from '../components/DocsFileTree.astro';

const { lang = 'zh', entry } = Astro.props as {
	lang: Lang;
	entry: CollectionEntry<'docs'>;
};

const currentSlug = entry.data.slug ?? entry.slug.split('/').pop() ?? entry.slug;
const site = Astro.site?.href ?? 'https://itkdm.com';
const canonical = new URL(`/${lang}/docs/${currentSlug}/`, site).href;
const jsonLd = {
	'@context': 'https://schema.org',
	'@type': 'TechArticle',
	headline: entry.data.title,
	description: entry.data.summary ?? entry.data.title,
	inLanguage: lang,
	mainEntityOfPage: canonical,
	url: canonical,
	dateModified: entry.data.updated ? entry.data.updated.toISOString() : undefined,
	publisher: {
		'@type': 'Organization',
		name: '布吉岛',
		logo: {
			'@type': 'ImageObject',
			url: new URL('/logo.jpg', site).href,
		},
	},
};

const { Content, headings } = await entry.render();
---

<BaseLayout
	lang={lang}
	title={entry.data.title}
	description={entry.data.summary ?? entry.data.title}
	currentPath={`/${lang}/docs/${currentSlug}/`}
	ogType="article"
	ogImage="/logo.jpg"
	jsonLd={jsonLd}
>
	<div class="docs-reader">
		<aside class="docs-reader-tree">
			<DocsFileTree lang={lang} currentSlug={currentSlug} />
		</aside>

		<article class="docs-article">
			<header class="article-head">
				<a class="back-link" href={`/${lang}/docs/`}>{lang === 'zh' ? '文档目录' : 'Docs'}</a>
				<h1>{entry.data.title}</h1>
				{entry.data.summary && <p>{entry.data.summary}</p>}
				{headings.length > 0 && (
					<nav class="article-toc" aria-label={lang === 'zh' ? '本页目录' : 'On this page'}>
						{headings.map((heading) => (
							<a href={`#${heading.slug}`}>{heading.text}</a>
						))}
					</nav>
				)}
			</header>

			<div class="article-body">
				<Content />
			</div>
		</article>
	</div>
</BaseLayout>

<style>
	.docs-reader {
		display: grid;
		grid-template-columns: minmax(280px, 340px) minmax(0, 1fr);
		gap: 22px;
		max-width: 1380px;
		margin: 0 auto;
		padding: 24px 16px 64px;
		align-items: start;
	}

	.docs-reader-tree {
		position: sticky;
		top: 86px;
		min-width: 0;
	}

	.docs-article {
		min-width: 0;
		border: 1px solid var(--border);
		border-radius: 8px;
		background: var(--bg-elev);
		overflow: hidden;
	}

	.article-head {
		padding: 26px 30px 24px;
		border-bottom: 1px solid var(--border);
		background:
			linear-gradient(90deg, color-mix(in srgb, var(--primary-soft) 28%, transparent), transparent),
			var(--bg-elev);
	}

	.back-link {
		display: inline-flex;
		margin-bottom: 12px;
		color: var(--primary);
		font-size: 0.86rem;
		font-weight: 800;
		text-decoration: none;
	}

	.back-link:hover {
		text-decoration: underline;
	}

	.article-head h1 {
		margin: 0;
		font-size: 2rem;
		line-height: 1.18;
		letter-spacing: 0;
	}

	.article-head p {
		max-width: 820px;
		margin: 12px 0 0;
		color: var(--text-muted);
		line-height: 1.7;
	}

	.article-toc {
		display: flex;
		flex-wrap: wrap;
		gap: 8px;
		margin-top: 18px;
	}

	.article-toc a {
		max-width: 240px;
		overflow: hidden;
		text-overflow: ellipsis;
		white-space: nowrap;
		border: 1px solid var(--border);
		border-radius: 6px;
		padding: 5px 9px;
		color: var(--text-muted);
		background: var(--bg);
		font-size: 0.82rem;
		text-decoration: none;
	}

	.article-toc a:hover {
		color: var(--text);
		border-color: var(--primary);
	}

	.article-body {
		padding: 28px 30px 42px;
	}

	.article-body :global(h1),
	.article-body :global(h2),
	.article-body :global(h3),
	.article-body :global(h4),
	.article-body :global(h5),
	.article-body :global(h6) {
		scroll-margin-top: 120px;
		letter-spacing: 0;
	}

	.article-body :global(h1:first-child) {
		display: none;
	}

	.article-body :global(p),
	.article-body :global(li) {
		line-height: 1.82;
	}

	.article-body :global(pre) {
		overflow: auto;
		border: 1px solid var(--border);
		border-radius: 8px;
		padding: 16px;
	}

	.article-body :global(code) {
		font-family: 'JetBrains Mono', ui-monospace, SFMono-Regular, Consolas, monospace;
	}

	.article-body :global(pre code) {
		display: block;
		background: transparent;
		color: inherit;
		font-size: 0.92rem;
		line-height: 1.75;
		white-space: pre;
	}

	.article-body :global(pre[data-language='txt']),
	.article-body :global(pre[data-language='plaintext']) {
		border-color: #d9e4f2;
		background: #f8fafc !important;
		color: #0f172a !important;
		box-shadow: inset 0 1px 0 rgba(255, 255, 255, 0.72);
	}

	.article-body :global(pre[data-language='txt'] code),
	.article-body :global(pre[data-language='plaintext'] code),
	.article-body :global(pre[data-language='txt'] code *),
	.article-body :global(pre[data-language='plaintext'] code *) {
		color: inherit !important;
	}

	.article-body :global(:not(pre) > code) {
		border: 1px solid #d9e4f2;
		border-radius: 5px;
		padding: 0.1em 0.36em;
		background: #f8fafc;
		color: #0f172a;
		font-size: 0.92em;
	}

	.article-body :global(blockquote) {
		margin-left: 0;
		border-left: 3px solid var(--primary);
		padding: 10px 14px;
		background: color-mix(in srgb, var(--primary-soft) 25%, transparent);
		color: var(--text-muted);
	}

	.article-body :global(table) {
		width: 100%;
		border-collapse: collapse;
		display: block;
		overflow-x: auto;
	}

	.article-body :global(th),
	.article-body :global(td) {
		border: 1px solid var(--border);
		padding: 8px 10px;
	}

	@media (max-width: 900px) {
		.docs-reader {
			grid-template-columns: 1fr;
			padding: 14px 12px 48px;
		}

		.docs-reader-tree {
			position: relative;
			top: 0;
		}

		.article-head,
		.article-body {
			padding-left: 18px;
			padding-right: 18px;
		}
	}
</style>
